{
  // Cloudflare Workers에 올릴 때 쓰는 설정이다. `npx wrangler deploy` 한 번으로 빌드와 배포가 된다.
  // 앱(dist/)은 정적 파일로 나가고, 클라우드 백업 서버(worker/)가 같은 Worker에 들어 있다.
  "name": "health",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    // /api/ 로 온 요청만 Worker가 먼저 받는다. 나머지는 Worker를 거치지 않고 정적 파일이 바로 나간다.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // 백업 보관함의 이름. 복구 코드를 잃어버렸으면 이 값을 바꿔 배포해서 빈 보관함에서 새로 시작한다(README의 클라우드 백업).
    "VAULT_NAME": "main"
  },
  // 클라우드 백업을 담는 Durable Object. 대시보드에서 따로 만들 것은 없다.
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }],
  // PR 브랜치의 미리보기 빌드(`npx wrangler preview`)가 쓰는 설정. 위의 vars와 바인딩은 미리보기로 넘어오지 않아서 다시 적는다.
  // 미리보기마다 빈 보관함이 따로 생기므로 실제 백업은 건드리지 않는다.
  "previews": {
    "vars": {
      "VAULT_NAME": "main"
    },
    "durable_objects": {
      "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
    }
  }
}
