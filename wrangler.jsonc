{
  // Cloudflare Workers에 정적 사이트로 배포할 때 쓰는 설정이다. `npx wrangler deploy` 한 번으로 빌드와 배포가 된다.
  "name": "health",
  "compatibility_date": "2026-11-16",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  // PR 브랜치의 미리보기 빌드(`npx wrangler preview`)는 이 항목이 있어야 돈다. 비어 있어도 된다.
  "previews": {}
}
